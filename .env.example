# Backend API base (includes the /api prefix).
VITE_API_URL=http://localhost:8080/api

# Base domain for the storefront preview iframe in the theme editor.
# The operator preview URL is built as: http(s)://{subdomain}.{this}/
# (https unless the value contains "localhost"). Defaults to localhost:5173
# in code if unset. Set per environment (e.g. staging.myvointika.com).
VITE_STOREFRONT_BASE_DOMAIN=localhost:5173
